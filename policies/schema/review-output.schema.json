{
  "$comment": "No $schema: provider CLIs validate this with a draft-07 validator that rejects the 2020-12 meta-schema. Every keyword here means the same in both drafts.",
  "$id": "https://campusbyrise.com/schemas/review-output.schema.json",
  "title": "Factory PR review model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "clean",
        "findings",
        "missing_spec"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "severity",
          "confidence",
          "path",
          "line",
          "title",
          "evidence",
          "failureScenario",
          "requestedChange",
          "source"
        ],
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "standards",
              "spec"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.9,
            "maximum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "failureScenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "requestedChange": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
